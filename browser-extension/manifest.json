{
  "manifest_version": 3,
  "name": "Harkas Password Manager",
  "version": "1.1.0",
  "description": "Veilig inloggen, wachtwoorden genereren en accounts beheren in Harkas Admin.",
  "minimum_chrome_version": "106",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://www.harkasit.nl/*"
    ]
  },
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Harkas Password Manager",
    "default_popup": "popup.html"
  },
  "incognito": "not_allowed",
  "key": ""
}
