{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/quotes.ts": {
      "includeFiles": "src/assets/logo.png",
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/favicon.ico",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/svg+xml"
        }
      ]
    },
    {
      "source": "/demo/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/veranda/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/verhuizen/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/diensten/marketing",
      "destination": "/diensten/automatisering",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/favicon.svg"
    },
    {
      "source": "/verhuizen",
      "destination": "/verhuizen/index.html"
    },
    {
      "source": "/verhuizen/",
      "destination": "/verhuizen/index.html"
    },
    {
      "source": "/veranda",
      "destination": "/veranda/index.html"
    },
    {
      "source": "/veranda/",
      "destination": "/veranda/index.html"
    },
    {
      "source": "/factuurgegevens",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|veranda/|verhuizen/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/support-notify",
      "schedule": "7 8 * * *"
    }
  ]
}
